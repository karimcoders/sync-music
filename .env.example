# ---------------------------------------------------------------------------
# sync-music — copy to .env and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# Public HTTPS origin of the backend (used to build signed audio URLs + wss)
DOMAIN=suger.sh
PUBLIC_BASE_URL=https://suger.sh
# Optional CDN in front of the audio objects (strongly recommended at scale)
CDN_BASE_URL=

# Secrets — generate with: openssl rand -base64 48
TOKEN_SECRET=replace-me
AUDIO_URL_SECRET=replace-me

# --- INFRASTRUCTURE capacity (NOT a product speaker limit) ------------------
# How many websocket connections one backend instance accepts before it answers
# "Server is currently at capacity". Scale out horizontally to raise it.
MAX_CONNECTIONS_PER_INSTANCE=5000
# Optional per-session infra guard. 0 = disabled (default, recommended).
MAX_SPEAKERS_PER_SESSION_INFRA=0
# How many speaker rows are pushed to the host UI per snapshot (count is always full)
SPEAKER_SNAPSHOT_LIMIT=200

# Session / media lifecycle
SESSION_TTL_MS=43200000
SPEAKER_GRACE_MS=60000
AUDIO_TOKEN_TTL_MS=21600000
MAX_UPLOAD_BYTES=62914560
ALLOWED_AUDIO_MIME=audio/mpeg,audio/mp3,audio/mp4,audio/aac,audio/x-m4a,audio/m4a,audio/wav,audio/x-wav

# Storage
DATA_DIR=/data
STORAGE_DRIVER=local

# Redis — required for horizontal scaling (pub/sub + shared session state)
REDIS_URL=redis://redis:6379

# Serve the built speaker web app from the same container (single-box mode)
SERVE_WEB=true
WEB_DIR=/app/web
TRUST_PROXY=true
